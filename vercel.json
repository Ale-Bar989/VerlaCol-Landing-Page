{
  "routes": [
    {
      "src": "/documents/pdf/(.*)",
      "dest": "/documents/pdf/$1",
      "headers": {
        "Cache-Control": "public, max-age=86400",
        "Content-Type": "application/pdf"
      }
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
